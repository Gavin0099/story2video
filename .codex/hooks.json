{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel)\" && [ -f \"$repo_root/.codex/hooks.json\" ] || exit 1; adapter=\"$repo_root/additional/ai-governance-framework/runtime_hooks/adapters/codex/user_prompt_submit.py\"; if [ ! -f \"$adapter\" ]; then printf '%s\\n' 'Codex UserPromptSubmit adapter missing' >&2; exit 1; fi; python3 \"$adapter\" --project-root \"$repo_root\"; status=$?; if [ \"$status\" -eq 2 ]; then exit 1; fi; exit \"$status\"",
            "commandWindows": "powershell -NoProfile -EncodedCommand ",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
