{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel)\" && [ -f \"$repo_root/.codex/hooks.json\" ] && python3 \"$repo_root/additional/ai-governance-framework/runtime_hooks/adapters/codex/user_prompt_submit.py\" --project-root \"$repo_root\"",
            "commandWindows": "powershell -NoProfile -EncodedCommand ",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
