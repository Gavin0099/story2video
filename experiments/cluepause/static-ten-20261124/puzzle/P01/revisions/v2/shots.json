  "narration": [
    {
      "id": "line-01",
      "en": "One snip. The gold suddenly weighed less.",
      "zh": "剪了一下。金子的讀值突然變輕了。",
      "voice": "af_heart",
      "speed": 1.08,
      "reveal": false,
      "not_before": 0,
      "gap_before": 0,
      "file": "assets/line-01.wav"
    },
    {
      "id": "line-02",
      "en": "Earlier, he charged for the higher reading. Both hands were here.",
      "zh": "剪線前，他按較高的讀值收費。兩隻手都在檯面上。",
      "voice": "af_heart",
      "speed": 1.08,
      "reveal": false,
      "not_before": 3.5,
      "gap_before": 0.08,
      "file": "assets/line-02.wav"
    },
    {
      "id": "line-03",
      "en": "She dropped her purse beside the counter.",
      "zh": "她的錢包掉在櫃檯旁。",
      "voice": "af_heart",
      "speed": 1.08,
      "reveal": false,
      "not_before": 7,
      "gap_before": 0.08,
      "file": "assets/line-03.wav"
    },
    {
      "id": "line-04",
      "en": "Under the scale: a brass weight, right beneath the thread.",
      "zh": "秤下面有個黃銅砝碼，就在細線正下方。",
      "voice": "af_heart",
      "speed": 1.08,
      "reveal": false,
      "not_before": 11,
      "gap_before": 0.08,
      "file": "assets/line-04.wav"
    },
    {
      "id": "line-05",
      "en": "The needle held steady as he slid her the bill.",
      "zh": "他把帳單推給她，指針一直停在高處。",
      "voice": "af_heart",
      "speed": 1.08,
      "reveal": false,
      "not_before": 15,
      "gap_before": 0.08,
      "file": "assets/line-05.wav"
    },
    {
      "id": "line-06",
      "en": "Where had the extra weight come from?",
      "zh": "多出來的重量，究竟從哪裡來？",
      "voice": "af_heart",
      "speed": 1.08,
      "reveal": false,
      "not_before": 23,
      "gap_before": 0.08,
      "file": "assets/line-06.wav"
    },
    {
      "id": "line-07",
      "en": "The brass weight stood on a shelf. His foot pulled the thread.",
      "zh": "黃銅砝碼放在架子上。是他的腳在拉線。",
      "voice": "af_heart",
      "speed": 1.08,
      "reveal": true,
      "not_before": 27,
      "gap_before": 0.08,
      "file": "assets/line-07.wav"
    },
    {
      "id": "line-08",
      "en": "She cut away his pull, not any gold.",
      "zh": "她剪掉的是他的拉力，金子一塊都沒少。",
      "voice": "af_heart",
      "speed": 1.08,
      "reveal": true,
      "not_before": 32,
      "gap_before": 0.08,
      "file": "assets/line-08.wav"
    }
  ],
