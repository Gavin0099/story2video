  "narration": [
    {
      "id": "line-01",
      "en": "She chose the vase with a black crack. The potter offered another.",
      "zh": "她挑了有黑色裂痕的花瓶，陶匠提議換一個。",
      "voice": "af_heart",
      "speed": 1.08,
      "reveal": false,
      "not_before": 0,
      "gap_before": 0
    },
    {
      "id": "line-02",
      "en": "No discount. No glue. She still wanted this one.",
      "zh": "沒有折扣，也沒有膠，她還是要這一個。",
      "voice": "af_heart",
      "speed": 1.08,
      "reveal": false,
      "not_before": 5,
      "gap_before": 0.08
    },
    {
      "id": "line-03",
      "en": "The thin line ran past the blue dot and across the table.",
      "zh": "細線經過藍點，還一路延伸到桌面。",
      "voice": "af_heart",
      "speed": 1.08,
      "reveal": false,
      "not_before": 10,
      "gap_before": 0.08
    },
    {
      "id": "line-04",
      "en": "Above it hung a wire mobile, turning in the window light.",
      "zh": "上方的鐵絲吊飾，在窗光裡轉動。",
      "voice": "af_heart",
      "speed": 1.08,
      "reveal": false,
      "not_before": 16,
      "gap_before": 0.08
    },
    {
      "id": "line-05",
      "en": "She moved her hand toward the line, without touching the vase.",
      "zh": "她把手伸向細線，卻沒碰到花瓶。",
      "voice": "af_heart",
      "speed": 1.08,
      "reveal": false,
      "not_before": 21,
      "gap_before": 0.08
    },
    {
      "id": "line-06",
      "en": "Her hand blocked the light. The crack disappeared.",
      "zh": "她的手擋住光，裂痕消失了。",
      "voice": "af_heart",
      "speed": 1.08,
      "reveal": true,
      "not_before": 27,
      "gap_before": 0.08
    },
    {
      "id": "line-07",
      "en": "She had bought an unbroken vase, with somebody else’s shadow.",
      "zh": "她買的是完整的花瓶，裂痕只是吊飾的影子。",
      "voice": "af_heart",
      "speed": 1.08,
      "reveal": true,
      "not_before": 32,
      "gap_before": 0.08
    }
  ],
